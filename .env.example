# Application
NODE_ENV=development
PORT=5000
HOST=127.0.0.1
FRONTEND_URL=http://127.0.0.1:5173
# Optional exact HTTPS tunnel origin, allowed only in development (for example Tailscale Serve).
DEV_FRONTEND_URL=
CERTIFICATE_ORGANIZATION_NAME=

# Local Vite proxy only; never put secrets in VITE_* variables.
DEV_API_TARGET=http://127.0.0.1:5000

# Database
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/ewaguard_ai

# Authentication. Generate a unique secret of at least 32 random characters.
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_ACCESS_TTL_SECONDS=1800
# Controlled dummy-data demonstrations only. Production rejects true.
DEMO_ACCOUNT_SETUP_ENABLED=false
# Administrator-issued invite links let anyone holding the link self-register an employee account.
# Set to false to disable issuing and redeeming invite links.
REGISTRATION_INVITES_ENABLED=true
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX=10

# Required for administrator sign-in. Generate 32 random bytes, encoded as 64 hex characters.
# Leave empty to disable administrator sign-in until securely configured.
MFA_ENCRYPTION_KEY=
MFA_TOTP_ISSUER=EWAGuard AI
MFA_CHALLENGE_TTL_SECONDS=300

# Required for human-confirmed email/URL operations; a separate random 32-byte hex key.
# Leave empty to disable preparation of new approvals. Never reuse JWT or MFA keys.
TOOL_APPROVAL_ENCRYPTION_KEY=

# OpenAI
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-6-luna
# RAG indexing uses the existing API key. Both allowed embedding models output 1536 dimensions here.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Conservative UTF-8 byte budget per explicitly indexed document, not a monetary quota.
RAG_EMBEDDING_MAX_DOCUMENT_BYTES=250000
# Model pricing/capabilities and hard spending ceilings are reviewed in backend/src/ai/chat-policy.js.

# Threat Intelligence
THREAT_INTELLIGENCE_API_KEY=YOUR_API_KEY
# Server-side only. Optional for local URL checks; never use a VITE_ prefix.
VIRUSTOTAL_API_KEY=
# File analyzer: absolute local executable paths, backend only.
CLAMAV_PATH=
YARA_PATH=
# Absolute rules file/directory. Development defaults to backend/security/yara.
YARA_RULES_PATH=

# Socket.IO
SOCKET_ORIGIN=http://localhost:5173

# Phase 15A prototype retention settings, NOT approved organizational policy.
# Keep disabled until the operator approves a preview and investigation/hold review.
RETENTION_ENABLED=false
RETENTION_PAUSED=false
RETENTION_BATCH_SIZE=100
RETENTION_INTERVAL_MINUTES=60
# Applied to NEW analysis/notification records only; existing deadlines are preserved.
RETENTION_EMAIL_DAYS=30
RETENTION_URL_DAYS=30
RETENTION_FILE_DAYS=30
RETENTION_NOTIFICATION_DAYS=90

# Community images (B1). Keep storage outside the repository/web root, on a
# private persistent volume in production. Empty uses a private OS-temp folder.
COMMUNITY_MEDIA_ROOT=
COMMUNITY_MAX_IMAGES=4
COMMUNITY_IMAGE_MAX_MIB=5
COMMUNITY_IMAGE_MAX_MEGAPIXELS=16
COMMUNITY_IMAGE_USER_QUOTA_MIB=100
COMMUNITY_IMAGE_TOTAL_QUOTA_MIB=1024
COMMUNITY_IMAGE_RETENTION_DAYS=90
COMMUNITY_IMAGE_REJECTED_DAYS=7
# Requires both CLAMAV_PATH and YARA_PATH/YARA_RULES_PATH; unavailable checks
# reject uploads. Scheduled cleanup honors RETENTION_ENABLED/RETENTION_PAUSED.
# Demonstration knowledge retrieval only; prohibited when NODE_ENV=production.
RAG_DEMONSTRATION_ENABLED=false
