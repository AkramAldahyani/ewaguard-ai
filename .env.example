# Application
NODE_ENV=development
PORT=5000
HOST=127.0.0.1
FRONTEND_URL=http://localhost:5173

# Local Vite proxy only; never put secrets in VITE_* variables.
DEV_API_TARGET=http://127.0.0.1:5000

# Database
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/ewaguard

# Authentication
# Reserved for later phases; not used by the Phase 0 application.
JWT_SECRET=CHANGE_ME

# OpenAI
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# Threat Intelligence
THREAT_INTELLIGENCE_API_KEY=YOUR_API_KEY

# Socket.IO
SOCKET_ORIGIN=http://localhost:5173
