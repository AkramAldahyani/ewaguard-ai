{
  "name": "ewaguard-ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["frontend", "backend"],
  "engines": { "node": ">=24.13.0 <25", "npm": ">=11 <12" },
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"npm run dev --workspace backend\" \"npm run dev --workspace frontend\"",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "start:backend": "npm run start --workspace backend",
    "build": "npm run build --workspace frontend",
    "lint": "eslint .",
    "test": "npm run test --workspace backend",
    "test:assistance": "node --test backend/tests/incident-assistance.test.js frontend/tests/incident-assistance.test.mjs",
    "test:risk": "node --test backend/tests/risk-engine.test.js frontend/tests/risk.test.mjs",
    "test:portal": "node --test frontend/tests/portal.integration.mjs",
    "test:chat": "node --test frontend/tests/chat.test.mjs",
    "test:chat:api": "node --test backend/tests/openai-adapter.test.js backend/tests/chat-api.integration.test.js",
    "chat:purge": "node backend/scripts/purge-expired-chats.js",
    "openai:verify:model": "node backend/scripts/verify-openai-model.js",
    "openai:verify:live": "node backend/scripts/verify-openai-live.js",
    "test:password": "node --test frontend/tests/password-security.test.mjs",
    "test:disclaimer": "node --test backend/tests/disclaimer.integration.test.js frontend/tests/disclaimer.test.mjs",
    "test:email": "node --test backend/tests/email-analyzer.test.js",
    "test:email:api": "node --test backend/tests/email-api.integration.test.js",
    "test:email:ui": "node --test frontend/tests/email.test.mjs",
    "test:url": "node --test backend/tests/url-analyzer.test.js",
    "test:url:api": "node --test backend/tests/url-api.integration.test.js",
    "test:url:ui": "node --test frontend/tests/url.test.mjs",
    "test:file": "node --test backend/tests/file-analyzer.test.js",
    "test:file:api": "node --test backend/tests/file-api.integration.test.js",
    "test:file:ui": "node --test frontend/tests/file.test.mjs",
    "check:backend": "node --check backend/src/server.js && node --check backend/src/app.js && node --check backend/src/config/env.js && node --check backend/src/config/database.js && node --check backend/src/auth/auth-token.js && node --check backend/src/auth/auth-service.js && node --check backend/src/disclaimers/disclaimer-service.js && node --check backend/src/middleware/authenticate.js && node --check backend/src/middleware/trusted-origin.js && node --check backend/src/routes/auth.js && node --check backend/src/routes/disclaimers.js",
    "prisma:format": "prisma format --config backend/prisma.config.js",
    "prisma:validate": "prisma validate --config backend/prisma.config.js",
    "prisma:generate": "prisma generate --config backend/prisma.config.js",
    "db:migrate": "prisma migrate deploy --config backend/prisma.config.js",
    "db:status": "prisma migrate status --config backend/prisma.config.js",
    "db:seed": "prisma db seed --config backend/prisma.config.js",
    "db:seed:auth": "node backend/prisma/seed-auth.js",
    "test:database": "node --test backend/tests/database.integration.js",
    "test:vector": "node --test backend/tests/vector.integration.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "concurrently": "^9.2.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.0.0",
    "prisma": "^7.10.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "shell-quote": "1.12.0",
    "mysql2": "3.24.5"
  }
}
